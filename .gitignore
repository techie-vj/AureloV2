#-------------------------------------------------------------------------------
# Generated by Android Studio and other common development tools.
# Add this file to the root of your project.
#-------------------------------------------------------------------------------

# Build and output directories
/build/
.gradle/
.externalNativeBuild/
.idea
/captures/
/out/

# Local configuration files (IDE specific)
.idea/
*.iml
*.iws
*.ipr
local.properties
.cxx/
.navigation/

# Android Studio and IntelliJ IDEA specific files
# These are often contained within .idea/, but some might appear at the root.
# Generally, avoid committing anything that is specific to your local IDE setup.
# .name (some older IDE versions/setups might create this at the root)
# If you explicitly find a .name file at the project root and it's IDE-generated,
# you can uncomment the line below or add it.
# .name

# Keystore files (NEVER commit these!)
*.jks
*.keystore

# Native library and shared object files
/libs/*/
/nativeLibs/*/
*.so
*.a

# Test output
/test_results/

# Log files
*.log

# Crashlytics/Fabric (if used without official plugin which manages it)
fabric.properties

# AVD files
*.avd

# macOS specific files
.DS_Store
.localized
ehthumbs.db
Thumbs.db

# Windows specific files
*.bak
$RECYCLE.BIN/
System Volume Information/

# KMM specific files (if using Kotlin Multiplatform Mobile)
# .kotlin/

# Ignore all user-specific files generated by Android Studio
# This helps prevent conflicts if multiple developers work on the same project
# and ensures that each developer has their own local settings.
# For example, build/generated/source/buildConfig/debug/com/example/app/BuildConfig.java
# is an example of a generated file that should not be committed.
# The general rule is: if it's generated by the build system or IDE, ignore it.
/app/build/
/app/build/
scripts/__pycache__/
