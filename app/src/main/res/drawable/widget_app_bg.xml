<?xml version="1.0" encoding="utf-8"?>
<!--
  Background drawable for each app slot card in the Aurelo widget.
  Place in: app/src/main/res/drawable/widget_app_bg.xml

  Semi-transparent white rounded rectangle — blends with any wallpaper
  and matches the dark-navy widget card set in applyTheme().
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 12% white — subtle card surface on the dark widget background -->
    <solid android:color="#1FFFFFFF" />

    <corners android:radius="10dp" />

</shape>
